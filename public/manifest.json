{
  "manifest_version": 3,
  "name": "TagMyEmail",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "tagmyemail@seguridades.org"
    }
  },
  "description": "Mejora tu higiene digital con etiquetas de sub-addressing automáticas.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"],
      "css": ["assets/sub-addressing.css"]
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
